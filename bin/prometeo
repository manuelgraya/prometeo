#!/usr/bin/env bash
# prometeo: lanzador para Linux y macOS (en Windows, bin\prometeo.cmd).
# Toda la lógica está en prometeo.py; uv lo ejecuta sin necesitar Python instalado.
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if ! command -v uv >/dev/null; then
  echo "✗ Falta 'uv' en el PATH. Instálalo con: curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
  exit 1
fi
exec uv run --quiet --script "$HERE/prometeo.py" "$@"
